# ── 敏感文件 ──
.env
.env.local
.env.*.local
.env.*
!.env.example
!*/.env.example
*/.env
backend/.env
frontend/.env

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ── Node / Vite ──
node_modules/
frontend/dist/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── 编译产物 / 临时 ──
dist/
build/
*.tsbuildinfo
.parcel-cache/

# ── 用户数据（不进版本库，运行时由 docker volume 挂载）──
data/uploads/*
!data/uploads/.gitkeep
data/img_cache/*
!data/img_cache/.gitkeep

# ── 数据库 dump ──
*.sql.bak
*.dump

# ── macOS / Windows ──
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── Claude / 其他工具缓存 ──
.claude/
claude-design/
.impeccable/

# ── Docker ──
.docker/
