# ── 数据库 ──
POSTGRES_USER=flipbook
POSTGRES_PASSWORD=flipbook
POSTGRES_DB=flipbook
# 容器内连库走 service 名 db；本地开发可改为 localhost:5434
DATABASE_URL=postgresql://flipbook:flipbook@localhost:5434/flipbook

# ── 后端 ──
API_PORT=8000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 容器部署时前端端口，默认 8080
FRONTEND_PORT=8080
FRONTEND_BIND=127.0.0.1
POSTGRES_PORT=5434

# ── 部署者默认配置（客户端提供配置头时整组使用客户端值，不混用部署者Key）──
# Anthropic 官方：sk-ant-...
# OpenAI 官方：sk-proj-...
# OpenRouter：sk-or-...
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-6

# ── 图片生成默认值 ──
# DALL-E 3 / Flux / GPT-Image
IMG_GEN_API_KEY=
IMG_GEN_BASE_URL=https://api.openai.com/v1
IMG_GEN_MODEL=dall-e-3
